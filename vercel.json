{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\", </llms-full.txt>; rel=\"describedby\"; type=\"text/plain\""
        }
      ]
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/en/latest",
      "destination": "/development/introduction",
      "permanent": true
    },
    {
      "source": "/en/latest/",
      "destination": "/development/introduction",
      "permanent": true
    },
    {
      "source": "/en/latest/:match(.*)",
      "destination": "/development/:match(.*)",
      "permanent": true
    },
    {
      "source": "/en/stable",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/stable/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/stable/:match(.*)",
      "destination": "/:match(.*)",
      "permanent": true
    },
    {
      "source": "/development",
      "destination": "/development/introduction",
      "permanent": true
    },
    {
      "source": "/how-to/run-a-bootnode",
      "destination": "/development/how-to/find-and-connect/run-a-bootnode",
      "permanent": true
    },
    {
      "source": "/concepts/p2p-private-key",
      "destination": "/development/concepts/p2p-networking#node-identity-and-private-key",
      "permanent": true
    },
    {
      "source": "/:path(\\d*\\.\\d*\\.\\d*)",
      "destination": "/:path*/introduction",
      "permanent": true
    },
    { "source": "/HowTo/Get-Started/Installation-Options/Install-Binaries", "destination": "/get-started/install/install-binaries", "permanent": true },
    { "source": "/HowTo/Get-Started/Installation-Options/Build-From-Source", "destination": "/get-started/install/build-from-source", "permanent": true },
    { "source": "/HowTo/Get-Started/Installation-Options/Run-Docker-Image", "destination": "/get-started/install/run-docker-image", "permanent": true },
    { "source": "/HowTo/Get-Started/Run-Teku", "destination": "/get-started/start-teku", "permanent": true },
    { "source": "/HowTo/Get-Started/Connect/Connect-To-Mainnet", "destination": "/get-started/connect/mainnet", "permanent": true },
    { "source": "/HowTo/Get-Started/Connect/Connect-To-Testnet", "destination": "/get-started/connect/testnet", "permanent": true },
    { "source": "/HowTo/Get-Started/Checkpoint-Start", "destination": "/get-started/checkpoint-start", "permanent": true },
    { "source": "/HowTo/Get-Started/Manage-Memory", "destination": "/get-started/manage-memory", "permanent": true },
    { "source": "/HowTo/Get-Started/Migrate-to-Teku", "destination": "/get-started/migrate-to-teku", "permanent": true },
    { "source": "/category/external-signing", "destination": "/how-to/use-external-signer", "permanent": true },
    { "source": "/HowTo/External-Signer/Use-External-Signer", "destination": "/how-to/use-external-signer/use-web3signer", "permanent": true },
    { "source": "/HowTo/External-Signer/Manage-keys", "destination": "/how-to/use-external-signer/manage-keys", "permanent": true },
    { "source": "/HowTo/Load-Validators-No-Restart", "destination": "/how-to/load-validators-without-restarting", "permanent": true },
    { "source": "/HowTo/Monitor/Metrics", "destination": "/how-to/monitor/use-metrics", "permanent": true },
    { "source": "/HowTo/Monitor/Logging", "destination": "/how-to/monitor/configure-logging", "permanent": true },
    { "source": "/HowTo/Configure/Use-Configuration-File", "destination": "/how-to/configure/use-config-file", "permanent": true },
    { "source": "/HowTo/Configure/Proposer-Configuration", "destination": "/how-to/configure/use-proposer-config-file", "permanent": true },
    { "source": "/HowTo/Configure/Configure-TLS", "destination": "/how-to/configure/tls", "permanent": true },
    { "source": "/HowTo/Configure/Builder-Network", "destination": "/how-to/configure/builder-network", "permanent": true },
    { "source": "/HowTo/Find-and-Connect/Specifying-NAT", "destination": "/how-to/find-and-connect/specify-nat", "permanent": true },
    { "source": "/HowTo/Find-and-Connect/Improve-Connectivity", "destination": "/how-to/find-and-connect/improve-connectivity", "permanent": true },
    { "source": "/HowTo/Voluntary-Exit", "destination": "/how-to/voluntarily-exit", "permanent": true },
    { "source": "/HowTo/Reconstruct-Historical-States-Service", "destination": "/how-to/reconstruct-historical-states", "permanent": true },
    { "source": "/HowTo/Sentry-Nodes", "destination": "/how-to/use-sentry-nodes", "permanent": true },
    { "source": "/category/troubleshoot", "destination": "/how-to/troubleshoot", "permanent": true },
    { "source": "/HowTo/Troubleshoot/Troubleshooting", "destination": "/how-to/troubleshoot", "permanent": true },
    { "source": "/HowTo/Withdrawal-Keys", "destination": "/how-to/update-withdrawal-keys", "permanent": true },
    { "source": "/HowTo/Doppelganger-Detection", "destination": "/development/how-to/prevent-slashing/detect-doppelgangers", "permanent": true },
    { "source": "/how-to/enable-doppelganger-detection", "destination": "/development/how-to/prevent-slashing/detect-doppelgangers", "permanent": true },
    { "source": "/HowTo/Migrate-Database", "destination": "/how-to/migrate-database", "permanent": true },
    { "source": "/HowTo/Prevent-Slashing", "destination": "/how-to/prevent-slashing", "permanent": true },
    { "source": "/Concepts/ArchitectureOverview", "destination": "/concepts/architecture", "permanent": true },
    { "source": "/Reference/CLI/CLI-Syntax", "destination": "/reference/cli", "permanent": true },
    { "source": "/category/get-started", "destination": "/get-started", "permanent": true },
    { "source": "/category/install-teku", "destination": "/get-started/install", "permanent": true },
    { "source": "/category/connect-to-a-network", "destination": "/get-started/connect", "permanent": true },
    { "source": "/category/how-to", "destination": "/how-to", "permanent": true },
    { "source": "/category/configure", "destination": "/how-to/configure", "permanent": true },
    { "source": "/category/use-an-external-signer", "destination": "/how-to/use-external-signer", "permanent": true },
    { "source": "/category/find-and-connect-to-peers", "destination": "/how-to/find-and-connect", "permanent": true },
    { "source": "/category/monitor-nodes", "destination": "/how-to/monitor", "permanent": true },
    { "source": "/category/concepts", "destination": "/concepts", "permanent": true },
    { "source": "/category/tutorials", "destination": "/tutorials", "permanent": true },
    { "source": "/concepts/merge", "destination": "/concepts", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/index.md"
    },
    {
      "source": "/:path((?!.*\\.).*)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/:path.md"
    }
  ]
}
